#N canvas 0 0 800 600 10;
#X obj 50 50 cnv 15 700 40 empty empty Pd-MCP-Server 20 12 0 14 #e0e0e0 #404040 0;
#X text 100 80 Dynamic patching via OSC;
#X obj 50 150 iemnet/udpreceive 5000;
#X obj 50 180 osc/unpackOSC;
#X obj 50 210 osc/routeOSC /pd/create /pd/connect /pd/dsp /pd/clear;
#X obj 30 241 print CREATE-MSG;
#X obj 255 241 print CONNECT-MSG;
#X obj 450 241 print DSP-MSG;
#X text 47 100 1. Click "listen 5000" to start;
#X msg 112 123 listen 5000;
#X obj 450 310 route 1 0;
#X msg 450 350 \; pd dsp 1;
#X msg 530 350 \; pd dsp 0;
#X text 50 430 Objects are created in the workspace subpatch;
#X text 50 450 Open "workspace" to see created objects;
#N canvas 0 0 450 300 workspace 1;
#X restore 50 480 pd workspace;
#X obj 50 280 list prepend obj;
#X obj 50 310 list trim;
#X obj 50 340 s pd-workspace;
#X obj 255 280 unpack 0 0 0 0;
#X obj 255 310 pack f f f f;
#X msg 255 350 \; pd-workspace connect \$1 \$2 \$3 \$4;
#X obj 450 390 print DSP-STATUS;
#X msg 600 280 \; pd-workspace clear;
