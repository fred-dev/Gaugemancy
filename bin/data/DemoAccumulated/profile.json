{
  "version": 1,
  "name": "DemoAccumulated",
  "logLevel": "notice",
  "playMode": "accumulated",
  "controlRateHz": 100,
  "presetSwitchMinIntervalMs": 2000,
  "presets": [
    "presets/preset_1.json"
  ],
  "sensors": {
    "maxRaw": 530,
    "activeThreshold": 0.035,
    "curve": "linear",
    "calibrationFrames": 16,
    "accumulationDenominator": 3.0,
    "smoothingMs": 20.0
  },
  "motion": {
    "enabled": true,
    "zeroAtStartup": true,
    "upAxis": "+z",
    "rangeDegrees": 45,
    "deadzoneDegrees": 3,
    "smoothingMs": 80,
    "shakeSensitivity": 0.5,
    "shakeReleaseMs": 300,
    "calibrationFrames": 20
  },
  "audio": {
    "sampleRate": 44100,
    "bufferSize": 512,
    "numBuffers": 3,
    "api": "default",
    "deviceName": "",
    "deviceId": -1,
    "masterGain": 0.8,
    "pi": {
      "enabled": false,
      "api": "default",
      "deviceName": "",
      "deviceId": -1
    }
  },
  "gestures": {
    "hitToChangePreset": true,
    "hitThreshold": 0.25,
    "troughThreshold": 0.08,
    "maxPeakMs": 300,
    "maxTroughMs": 300,
    "requiredHits": 4,
    "minSensorsPerHit": 2
  },
  "hardware": {
    "spiDevice": "/dev/spidev0.0",
    "adcChannels": [
      0,
      1,
      2,
      3,
      4,
      5
    ],
    "buttonPin": 19,
    "buttonActiveLow": true,
    "blueLedPin": 5,
    "redLedPin": 6,
    "relayPin": 13,
    "relayPulseMs": 400,
    "clickTimeoutMs": 240,
    "longPressQuits": false,
    "shutdownOnQuit": false,
    "accelerometer": true,
    "i2cBus": "/dev/i2c-1",
    "accelAddress": 24
  },
  "osc": {
    "telemetry": false,
    "remoteHost": "127.0.0.1",
    "remotePort": 1235,
    "control": true,
    "controlPort": 1234,
    "telemetryRateHz": 20
  },
  "narration": {
    "enabled": false,
    "file": "narration.wav",
    "volume": 1.0,
    "startWithSensor": true,
    "autoStartDelayMs": 5000,
    "glitchThreshold": 0.1,
    "glitchStrand": 0.02,
    "window": "hann",
    "grain": {
      "length": {
        "value": 400,
        "min": 80,
        "max": 900,
        "source": "none"
      },
      "density": {
        "value": 0.8,
        "min": 0.3,
        "max": 1.0,
        "source": "none"
      },
      "distanceJitter": {
        "value": 20,
        "min": 0,
        "max": 200,
        "source": "none"
      },
      "pitchJitter": {
        "value": 0,
        "min": 0,
        "max": 2,
        "source": "none"
      },
      "pitch": {
        "value": 0,
        "min": -7,
        "max": 7,
        "source": "none"
      },
      "spread": {
        "value": 0.02,
        "min": 0,
        "max": 0.2,
        "source": "none"
      },
      "volume": {
        "value": 0.6,
        "min": 0.0,
        "max": 0.9,
        "source": "none"
      },
      "position": {
        "value": 0.5,
        "min": 0.0,
        "max": 1.0,
        "source": "none"
      },
      "direction": {
        "value": 1,
        "min": -1,
        "max": 1,
        "source": "none"
      }
    },
    "effects": [
      {
        "type": "compressor",
        "enabled": true,
        "params": {
          "gain": {
            "value": 1.0,
            "min": 0,
            "max": 10,
            "source": "none"
          },
          "threshold": {
            "value": -12,
            "min": -50,
            "max": 0,
            "source": "none"
          },
          "ratio": {
            "value": 4,
            "min": 1,
            "max": 40,
            "source": "none"
          },
          "attack": {
            "value": 10,
            "min": 1,
            "max": 60,
            "source": "none"
          },
          "release": {
            "value": 80,
            "min": 10,
            "max": 250,
            "source": "none"
          },
          "knee": {
            "value": 3,
            "min": 0,
            "max": 10,
            "source": "none"
          }
        }
      }
    ]
  }
}
